# ─── Security ────────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=<generate-32-char-hex-secret>

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_URL=postgresql+asyncpg://cat_user:cat_password@postgres:5432/cat_db
POSTGRES_PASSWORD=cat_password

# ─── ClickHouse ───────────────────────────────────────────────────────────────
CLICKHOUSE_URL=clickhouse://cat_user:cat_password@clickhouse:9000/cat_analytics
CLICKHOUSE_PASSWORD=cat_password

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── MinIO (S3-compatible storage) ───────────────────────────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET_REFERENCES=cat-references

# ─── SMTP (MailHog for local dev) ────────────────────────────────────────────
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_FROM_EMAIL=noreply@cat.local
SMTP_USER=
SMTP_PASSWORD=test

# ─── Scraping / Proxy (optional for local dev) ───────────────────────────────
# PROXY_LIST_URL=https://fineproxy.org/api/getproxy/?format=txt&type=https_ip&login=LOGIN&password=PASS
# PROXY_USER=
# PROXY_PASS=

# ─── ML Models ───────────────────────────────────────────────────────────────
# Models auto-download to Docker volume on first run (~1.5GB)
HF_HOME=/root/.cache/huggingface
